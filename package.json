{
  "name": "board",
  "private": true,
  "license": "SEE LICENSE IN LICENSE.md",
  "description": "Simple kanban and table boards you can share and edit together in real time.",
  "repository": "github:sadcock1/boards",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "MAIL_LOG=1 node --watch --disable-warning=ExperimentalWarning server/index.ts",
    "build": "tsc --noEmit && vite build",
