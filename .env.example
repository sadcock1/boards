# Copy to .env next to docker-compose.yml (or export these) and fill in what you need.
# Everything here is optional.

# Accounts that can open the admin dashboard at /admin (comma-separated)
ADMIN_EMAILS=you@example.com

# --- Email (optional) -------------------------------------------------------
# Leave SMTP_HOST empty to run without email: no verification, no "forgot password".
SMTP_HOST=smtp.example.com
# 465 = TLS, 587 = STARTTLS
SMTP_PORT=465
SMTP_USER=boards@example.com
SMTP_PASS=
MAIL_FROM=Boards <boards@example.com>
# Public address of your site, used for links in emails
APP_URL=https://boards.example.com
